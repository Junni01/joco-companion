      },
      "theme": "bureaucracy",
      "lines": [
        {
          "speaker": "Chronicler",
          "text": "Storms troubled the western, southern and eastern seas alike. The Company's correspondence filled with anxious inquiries and competing claims of urgency."
        },
        {
          "speaker": "Senior clerk",
          "text": "\"We have three offices demanding immediate attention.\""
        },
        {
          "speaker": "Junior clerk",
          "text": "\"Which should we answer first?\""
        },
        {
          "speaker": "Senior clerk",
          "text": "\"The one whose correspondent knows the most Directors.\""
        }
      ]
    },
    "tension": {
      "version": 1,
      "key": "tension",
      "kind": "tension",
      "templateId": "09E-T1-03",
      "context": {
        "count": 1
      },
      "theme": "sober",
      "lines": [
        {
          "speaker": "Chronicler",
          "text": "The season opened with fewer outward signs of disorder than some had feared. Experienced observers knew that a quiet court might still conceal an argument of considerable consequence."
        }
      ]
    }
  },
  {
    "invasion": [
