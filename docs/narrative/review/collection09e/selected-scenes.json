        "theme": "sober",
        "lines": [
          {
            "speaker": "Chronicler",
            "text": "The threat was no longer confined to one province. Bombay, Madras and Bengal faced foreign incursions, placing difficult demands on those responsible for their defence."
          }
        ]
      },
      {
        "version": 1,
        "key": "force:bombay",
